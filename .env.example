# ClaudeClaw configuration. Copy to .env and fill in.
# Never commit .env — it is gitignored.

# === REQUIRED ===

# Telegram bot token from @BotFather (free, 2 minutes to create)
TELEGRAM_BOT_TOKEN=

# Your Telegram chat ID. Comma-separate for multi-user.
# After first start, send /chatid to the bot to discover yours.
ALLOWED_CHAT_ID=

# === VOICE (optional) ===

# Groq API key for Whisper STT. Free tier at https://console.groq.com
GROQ_API_KEY=

# === MEDIA / TOOLS (optional, used by Claude via skills) ===

# Gemini API key for video analysis (free tier). https://aistudio.google.com
GOOGLE_API_KEY=

# Apify API token for web scraping. https://console.apify.com
APIFY_API_TOKEN=

# === MISC ===

LOG_LEVEL=info
