generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ──────────────────────────────────────────────
// USER & ROLES
// ──────────────────────────────────────────────

enum UserRole {
  CLIENT
  TEAM_MEMBER
  ADMIN
}

model User {
  id        String   @id @default(cuid())
  clerkId   String   @unique
  email     String   @unique
  firstName String?
  lastName  String?
  role      UserRole @default(CLIENT)
  avatarUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clientBrands   Brand[]       @relation("ClientBrands")
  assignedBrands Brand[]       @relation("AssignedTeam")
  decisions      Decision[]
  activityLog    ActivityLog[]
}

// ──────────────────────────────────────────────
// BRAND (central entity per client engagement)
// ──────────────────────────────────────────────

enum BrandStatus {
  ONBOARDING
  RESEARCH
  ANALYSIS
  STRATEGY
  ACTIVE
  PAUSED
  COMPLETED
}

model Brand {
  id        String      @id @default(cuid())
  name      String
  status    BrandStatus @default(ONBOARDING)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  clientId String
  client   User   @relation("ClientBrands", fields: [clientId], references: [id])

  teamMembers User[] @relation("AssignedTeam")

  onboarding  OnboardingResponse?
  researchJobs ResearchJob[]
  scrapedData  ScrapedDataSet[]
  analysisRuns AnalysisRun[]
  documents    GeneratedDocument[]
  adAccounts   AdAccount[]
  strategies   Strategy[]
  decisions    Decision[]
  activityLog  ActivityLog[]

  inspirationBoard InspirationBoard?
}

// ──────────────────────────────────────────────
// ONBOARDING
// ──────────────────────────────────────────────

model OnboardingResponse {
  id      String @id @default(cuid())
  brandId String @unique
  brand   Brand  @relation(fields: [brandId], references: [id], onDelete: Cascade)

  brandInfo       Json
  goals           Json
  targetAudience  Json
  currentState    Json
  competitors     Json?
  additionalNotes String? @db.Text

  completedAt DateTime?
  currentStep Int       @default(1)
  isComplete  Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ──────────────────────────────────────────────
// RESEARCH & SCRAPING
// ──────────────────────────────────────────────

enum DataSource {
  AMAZON_REVIEWS
  AMAZON_PRODUCT_COMMENTS
  REDDIT_POSTS
  REDDIT_COMMENTS
  INSTAGRAM_COMMENTS
  META_AD_LIBRARY
}

enum JobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

model ResearchJob {
  id      String @id @default(cuid())
  brandId String
  brand   Brand  @relation(fields: [brandId], references: [id], onDelete: Cascade)

  source       DataSource
  status       JobStatus @default(PENDING)
  apifyRunId   String?
  config       Json
  errorMessage String?   @db.Text
  startedAt    DateTime?
  completedAt  DateTime?
  itemCount    Int?

  scrapedDataSet ScrapedDataSet?

  inspirationBrands InspirationBrand[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ScrapedDataSet {
  id      String @id @default(cuid())
  brandId String
  brand   Brand  @relation(fields: [brandId], references: [id], onDelete: Cascade)

  researchJobId String      @unique
  researchJob   ResearchJob @relation(fields: [researchJobId], references: [id])

  source DataSource
  items  ScrapedItem[]

  createdAt DateTime @default(now())
}

model ScrapedItem {
  id        String         @id @default(cuid())
  dataSetId String
  dataSet   ScrapedDataSet @relation(fields: [dataSetId], references: [id], onDelete: Cascade)

  externalId  String?
  content     String    @db.Text
  author      String?
  authorUrl   String?
  sourceUrl   String?
  rating      Float?
  score       Int?
  publishedAt DateTime?
  rawData     Json?

  // Anti-astroturfing
  suspicionScore Float?  @default(0)
  suspicionFlags Json?
  isFlagged      Boolean @default(false)

  // Sentiment
  sentimentScore Float?
  sentimentLabel String?

  createdAt DateTime @default(now())

  @@index([dataSetId])
  @@index([isFlagged])
}

// ──────────────────────────────────────────────
// AI ANALYSIS
// ──────────────────────────────────────────────

enum AnalysisType {
  CONSUMER_INSIGHTS
  COMPETITIVE_ANALYSIS
  SENTIMENT_OVERVIEW
  AD_PERFORMANCE
  GROWTH_OPPORTUNITIES
  FULL_STRATEGY
}

model AnalysisRun {
  id      String @id @default(cuid())
  brandId String
  brand   Brand  @relation(fields: [brandId], references: [id], onDelete: Cascade)

  type         AnalysisType
  status       JobStatus    @default(PENDING)
  inputSummary Json?
  results      Json?
  rawResponse  String?      @db.Text
  promptUsed   String?      @db.Text
  tokenCount   Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ──────────────────────────────────────────────
// DOCUMENT GENERATION
// ──────────────────────────────────────────────

enum DocumentType {
  MASTER_DOCUMENT
  GROWTH_GUIDE
}

model GeneratedDocument {
  id      String @id @default(cuid())
  brandId String
  brand   Brand  @relation(fields: [brandId], references: [id], onDelete: Cascade)

  type          DocumentType
  title         String
  googleDocId   String?
  googleSheetId String?
  googleDriveUrl String?
  version       Int       @default(1)
  status        JobStatus @default(PENDING)
  generatedFrom Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ──────────────────────────────────────────────
// META ADS (Phase 2)
// ──────────────────────────────────────────────

model AdAccount {
  id      String @id @default(cuid())
  brandId String
  brand   Brand  @relation(fields: [brandId], references: [id], onDelete: Cascade)

  metaAdAccountId String
  accessToken     String  @db.Text
  accountName     String?
  isActive        Boolean @default(true)

  snapshots            AdPerformanceSnapshot[]
  creativePerformances CreativePerformance[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AdPerformanceSnapshot {
  id          String    @id @default(cuid())
  adAccountId String
  adAccount   AdAccount @relation(fields: [adAccountId], references: [id], onDelete: Cascade)

  dateRange  Json
  fetchedAt  DateTime @default(now())
  level      String
  entityId   String
  entityName String?
  metrics    Json
  isChampion Boolean  @default(false)

  @@index([adAccountId, fetchedAt])
}

// ──────────────────────────────────────────────
// STRATEGY & DECISIONS
// ──────────────────────────────────────────────

enum StrategyStatus {
  PROPOSED
  UNDER_REVIEW
  APPROVED
  IN_PROGRESS
  COMPLETED
  REJECTED
  DEFERRED
}

enum DecisionAction {
  APPROVE
  REJECT
  MODIFY
  DEFER
  ESCALATE
}

model Strategy {
  id      String @id @default(cuid())
  brandId String
  brand   Brand  @relation(fields: [brandId], references: [id], onDelete: Cascade)

  title          String
  description    String         @db.Text
  category       String
  source         String
  priority       Int            @default(0)
  status         StrategyStatus @default(PROPOSED)
  aiRationale    String?        @db.Text
  aiConfidence   Float?
  supportingData Json?

  decisions Decision[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Decision {
  id      String @id @default(cuid())
  brandId String
  brand   Brand  @relation(fields: [brandId], references: [id], onDelete: Cascade)

  strategyId String?
  strategy   Strategy? @relation(fields: [strategyId], references: [id])

  madeById String
  madeBy   User   @relation(fields: [madeById], references: [id])

  action    DecisionAction
  rationale String? @db.Text
  notes     String? @db.Text

  createdAt DateTime @default(now())
}

// ──────────────────────────────────────────────
// ACTIVITY LOG
// ──────────────────────────────────────────────

model ActivityLog {
  id      String @id @default(cuid())
  brandId String?
  brand   Brand?  @relation(fields: [brandId], references: [id])

  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  action  String
  details Json?

  createdAt DateTime @default(now())

  @@index([brandId, createdAt])
}

// ──────────────────────────────────────────────
// AD INSPIRATION LAYERS
// ──────────────────────────────────────────────

enum InspirationLayerType {
  DIRECT_COMPETITORS
  SAME_NICHE
  SAME_DESIRE_OUTCOME
  SAME_DEMOGRAPHIC
  TREND_SPOTTER
}

enum AdFormat {
  UGC
  STUDIO
  MEME
  CAROUSEL
  STATIC_IMAGE
  VIDEO
  SLIDESHOW
  COLLECTION
  STORIES
  REELS
  OTHER
}

model InspirationBoard {
  id      String @id @default(cuid())
  brandId String @unique
  brand   Brand  @relation(fields: [brandId], references: [id], onDelete: Cascade)

  layers InspirationLayer[]
  notes  String? @db.Text

  duplicateGroups  DuplicateGroup[]
  atomAnalysisJobs AtomAnalysisJob[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model InspirationLayer {
  id      String           @id @default(cuid())
  boardId String
  board   InspirationBoard @relation(fields: [boardId], references: [id], onDelete: Cascade)

  type          InspirationLayerType
  label         String?
  description   String?  @db.Text
  desireKeyword String?
  demographic   String?

  brands InspirationBrand[]
  trends TrendItem[]

  aiSuggestions Json?
  status        JobStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([boardId, type])
  @@index([boardId])
}

model InspirationBrand {
  id      String           @id @default(cuid())
  layerId String
  layer   InspirationLayer @relation(fields: [layerId], references: [id], onDelete: Cascade)

  name             String
  metaPageId       String?
  metaPageUrl      String?
  website          String?
  estimatedRevenue String?
  revenueCategory  String?
  socialFollowing  Int?
  adSpendEstimate  String?
  notes            String? @db.Text

  adLibraryScrapeJobId String?
  adLibraryScrapeJob   ResearchJob? @relation(fields: [adLibraryScrapeJobId], references: [id])
  lastScrapedAt        DateTime?

  adCreatives AdCreative[]

  isUserAdded Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([layerId])
}

model AdCreative {
  id      String           @id @default(cuid())
  brandId String
  brand   InspirationBrand @relation(fields: [brandId], references: [id], onDelete: Cascade)

  metaAdId        String?  @unique
  adLibraryUrl    String?
  screenshotUrl   String?
  videoUrl        String?
  thumbnailUrl    String?
  primaryText     String?  @db.Text
  headline        String?
  linkDescription String?
  ctaType         String?
  landingPageUrl  String?

  adStartDate DateTime?
  adEndDate   DateTime?
  isActive    Boolean   @default(true)

  format          AdFormat?
  hookType        String?
  ctaStyle        String?
  emotionalAppeal String?

  aiAnalysis Json?
  aiScore    Float?

  tags String[]

  rawData Json?

  // Atom analysis fields
  atomAnalysisStatus MediaProcessingStatus?
  geminiAnalysis     Json?
  mediaDownloaded    Boolean @default(false)

  // Atom analysis relations
  mediaAssets                MediaAsset[]
  atoms                      CreativeAtom[]
  performance                CreativePerformance?
  duplicateGroupMemberships  DuplicateGroupMember[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([brandId])
}

model TrendItem {
  id      String           @id @default(cuid())
  layerId String
  layer   InspirationLayer @relation(fields: [layerId], references: [id], onDelete: Cascade)

  title       String
  description String? @db.Text
  sourceUrl   String?
  sourceName  String?
  imageUrl    String?
  category    String?

  relevanceScore   Float?
  aiAdaptation     String? @db.Text
  aiRelevanceNotes String? @db.Text

  trendDate  DateTime?
  isRelevant Boolean   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([layerId])
}

// ──────────────────────────────────────────────
// AD CREATIVE ATOM ANALYSIS
// ──────────────────────────────────────────────

enum PerformanceTier {
  WINNER
  STRONG
  AVERAGE
  WEAK
  NON_SPENDER
  UNKNOWN
}

enum AtomCategory {
  VISUAL_HOOK
  TEXT_OVERLAY
  COLOR_PALETTE
  SCENE_COMPOSITION
  TALENT_ACTOR
  EMOTION
  MUSIC_AUDIO
  TRANSITION
  CTA_ELEMENT
  PRODUCT_PLACEMENT
  PACING
  LIGHTING_MOOD
  TYPOGRAPHY
  BRANDING_ELEMENT
  SOCIAL_PROOF_ELEMENT
  OTHER
}

enum MediaProcessingStatus {
  PENDING
  DOWNLOADING
  PROCESSING
  ANALYZED
  FAILED
}

enum DuplicateGroupStatus {
  AUTO_DETECTED
  CONFIRMED
  DISMISSED
}

model MediaAsset {
  id         String     @id @default(cuid())
  creativeId String
  creative   AdCreative @relation(fields: [creativeId], references: [id], onDelete: Cascade)

  originalUrl   String
  storagePath   String
  storageUrl    String
  mimeType      String
  fileSizeBytes Int?
  width         Int?
  height        Int?
  durationMs    Int?
  perceptualHash String?

  status       MediaProcessingStatus @default(PENDING)
  errorMessage String?               @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([creativeId])
  @@index([perceptualHash])
}

model CreativeAtom {
  id         String     @id @default(cuid())
  creativeId String
  creative   AdCreative @relation(fields: [creativeId], references: [id], onDelete: Cascade)

  category       AtomCategory
  name           String
  description    String       @db.Text
  confidence     Float
  timestampStart Int?
  timestampEnd   Int?
  boundingBox    Json?
  attributes     Json
  thumbnailUrl   String?

  correlations AtomPerformanceCorrelation[]

  createdAt DateTime @default(now())

  @@index([creativeId])
  @@index([category])
  @@index([name])
}

model CreativePerformance {
  id         String     @id @default(cuid())
  creativeId String     @unique
  creative   AdCreative @relation(fields: [creativeId], references: [id], onDelete: Cascade)

  metaAdAccountId String?
  adAccount       AdAccount? @relation(fields: [metaAdAccountId], references: [id])
  isManualEntry   Boolean    @default(false)

  spend          Float?
  impressions    Int?
  clicks         Int?
  ctr            Float?
  cpc            Float?
  cpm            Float?
  conversions    Int?
  conversionRate Float?
  roas           Float?
  revenue        Float?

  performanceTier PerformanceTier @default(UNKNOWN)

  dateRangeStart DateTime?
  dateRangeEnd   DateTime?

  rawMetrics Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([performanceTier])
}

model DuplicateGroup {
  id      String           @id @default(cuid())
  boardId String
  board   InspirationBoard @relation(fields: [boardId], references: [id], onDelete: Cascade)

  name    String?
  status  DuplicateGroupStatus @default(AUTO_DETECTED)

  members DuplicateGroupMember[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([boardId])
}

model DuplicateGroupMember {
  id      String         @id @default(cuid())
  groupId String
  group   DuplicateGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  creativeId      String
  creative        AdCreative @relation(fields: [creativeId], references: [id], onDelete: Cascade)
  similarityScore Float
  isPrimary       Boolean    @default(false)

  @@unique([groupId, creativeId])
  @@index([creativeId])
}

model AtomPerformanceCorrelation {
  id      String @id @default(cuid())
  boardId String

  atomCategory AtomCategory
  atomName     String

  atomId String?
  atom   CreativeAtom? @relation(fields: [atomId], references: [id])

  winnerCount      Int   @default(0)
  nonSpenderCount  Int   @default(0)
  totalOccurrences Int   @default(0)
  avgPerformanceScore Float?
  correlationStrength Float?

  insight    String? @db.Text
  sampleSize Int     @default(0)

  computedAt DateTime @default(now())

  @@index([boardId, atomCategory])
  @@index([correlationStrength])
}

model AtomAnalysisJob {
  id      String           @id @default(cuid())
  boardId String
  board   InspirationBoard @relation(fields: [boardId], references: [id], onDelete: Cascade)

  status         JobStatus @default(PENDING)
  totalItems     Int       @default(0)
  processedItems Int       @default(0)
  failedItems    Int       @default(0)
  errorMessage   String?   @db.Text

  creativeIds String[]

  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([boardId])
}
